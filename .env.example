# Скопируй этот файл в .env и заполни секретные ключи
# cp .env.example .env

# ============================
# База данных
# ============================
POSTGRES_DB=doapizza
POSTGRES_USER=doapizza
# ЗАПОЛНИТЬ: придумай сложный пароль для PostgreSQL
POSTGRES_PASSWORD=postgres

# ============================
# Django Backend
# ============================
# ЗАПОЛНИТЬ: сгенерировать командой:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
ALLOWED_HOSTS=89.208.96.100,127.0.0.1,0.0.0.0,localhost,backend
CORS_ALLOWED_ORIGINS=http://89.208.96.100
AUTH_CODE_EXPIRY_MINUTES=10

# ============================
# Telegram Bot
# ============================
# ЗАПОЛНИТЬ: токен от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# ============================
# NLP Service (OpenRouter)
# ============================
# ЗАПОЛНИТЬ: API-ключ с openrouter.ai
OPENROUTER_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=mistralai/mistral-small-3.1-24b-instruct:free
LLM_PROMPT_MODE=auto
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=2

# ============================
# Каталог (общее для tgbot и nlp-service)
# ============================
CATALOG_PIZZAS=Маргарита,Пепперони,Четыре сыра,Гавайская,Мясная,Карбонара
CATALOG_SIZE_CM=25,30,35
CATALOG_REFRESH_INTERVAL_SECONDS=300
CATALOG_HTTP_TIMEOUT_SECONDS=5

# ============================
# Таймауты и прочее
# ============================
LOG_LEVEL=INFO
TELEGRAM_POLL_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=10
NLP_REQUEST_TIMEOUT_SECONDS=45
ORDERS_HTTP_TIMEOUT_SECONDS=10
