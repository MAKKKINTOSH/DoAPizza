# ЗАПОЛНИТЬ: токен от @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# URL сервисов для локальной разработки:
NLP_SERVICE_BASE_URL=http://127.0.0.1:8001
CATALOG_API_URL=http://127.0.0.1:8000/api/restaurant/variants/
ORDERS_API_URL=http://127.0.0.1:8000/api/orders/create

# В Docker (docker-compose.prod.yaml) используются внутренние адреса сервисов:
# NLP_SERVICE_BASE_URL=http://nlp-service:8000
# CATALOG_API_URL=http://backend:8000/api/restaurant/variants/
# ORDERS_API_URL=http://backend:8000/api/orders/create

CATALOG_REFRESH_INTERVAL_SECONDS=300
CATALOG_HTTP_TIMEOUT_SECONDS=5
TELEGRAM_POLL_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=10
NLP_REQUEST_TIMEOUT_SECONDS=45
ORDERS_HTTP_TIMEOUT_SECONDS=10
CATALOG_PIZZAS=Маргарита,Пепперони,Четыре сыра,Гавайская,Мясная,Карбонара
LOG_LEVEL=INFO
